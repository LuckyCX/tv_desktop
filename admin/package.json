{
  "name": "cleanyourtv-admin",
  "version": "1.0.0",
  "private": true,
  "description": "CleanYourTV 局域网管理后台（无登录，仅限局域网使用）",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run server\" \"npm run client\"",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
