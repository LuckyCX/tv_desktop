<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B1218"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_hub_title"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- 系统 -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/hub_section_system" />

        <LinearLayout style="@style/SettingsCard">
            <TextView
                android:id="@+id/hubSystemSettings"
                style="@style/SettingsRowInCard"
                android:text="@string/tv_settings" />

            <View style="@style/SettingsDivider" />

            <TextView
                android:id="@+id/hubSwitchHome"
                style="@style/SettingsRowInCard"
                android:text="@string/home_settings" />
        </LinearLayout>

        <!-- 桌面 -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/hub_section_desktop" />

        <LinearLayout style="@style/SettingsCard">
            <TextView
                android:id="@+id/hubLauncherSettings"
                style="@style/SettingsRowInCard"
                android:text="@string/hub_desktop_layout" />

            <View style="@style/SettingsDivider" />

            <TextView
                android:id="@+id/hubWallpaperManage"
                style="@style/SettingsRowInCard"
                android:text="@string/wallpaper_manage" />

            <TextView
                android:id="@+id/hubWallpaperState"
                style="@style/SettingsRowSub"
                android:text="@string/wallpaper_manage_hint" />

            <View style="@style/SettingsDivider" />

            <TextView
                android:id="@+id/hubDefaultOpenToggle"
                style="@style/SettingsRowInCard"
                android:text="@string/default_open_section" />

            <TextView
                android:id="@+id/hubDefaultOpenPick"
                style="@style/SettingsRowSub"
                android:text="@string/default_open_pick" />
        </LinearLayout>

        <!-- 更新 -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/update_section" />

        <LinearLayout style="@style/SettingsCard">
            <EditText
                android:id="@+id/hubUpdateUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="@string/update_url_hint"
                android:inputType="textUri"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF6B7780"
                android:textSize="16sp" />

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:id="@+id/hubUpdateNow"
                    style="@style/SettingsColumnChoice"
                    android:layout_marginEnd="0dp"
                    android:text="@string/update_now" />
            </LinearLayout>

            <TextView
                android:id="@+id/hubUpdateProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:textColor="#FFACB8C1"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 推送 -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/push_section" />

        <LinearLayout style="@style/SettingsCard">
            <TextView
                android:id="@+id/hubPushAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"
                android:textColor="#FF4FC3F7"
                android:textSize="20sp"
                android:textIsSelectable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:text="@string/push_address_hint"
                android:textColor="#FF7A8A99"
                android:textSize="13sp" />

            <View style="@style/SettingsDivider" />

            <TextView
                android:id="@+id/hubPushHistory"
                style="@style/SettingsRowInCard"
                android:text="@string/push_history" />
        </LinearLayout>

        <!-- 备份 -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/backup_section" />

        <LinearLayout style="@style/SettingsCard">
            <TextView
                android:id="@+id/hubBackupCreate"
                style="@style/SettingsRowInCard"
                android:text="@string/backup_create" />

            <View style="@style/SettingsDivider" />

            <TextView
                android:id="@+id/hubBackupList"
                style="@style/SettingsRowInCard"
                android:text="@string/backup_list" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
